# ──────────────────────────────────────────────────────────────
# Database
# Use host.docker.internal when running inside Docker so the
# container can reach the host's Postgres instance.
# Use localhost when running the service directly on the host.
# ──────────────────────────────────────────────────────────────
DB_HOST=host.docker.internal
# DB_HOST=localhost   # uncomment when running outside Docker
DB_PORT=5433
DB_NAME=rkp_core
DB_USER=rkp_user
DB_PASSWORD=<your_db_password>

# ──────────────────────────────────────────────────────────────
# Anthropic (for summarization)
# ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ──────────────────────────────────────────────────────────────
# GitHub (for repo search / metadata)
# ──────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...

# ──────────────────────────────────────────────────────────────
# Admin
# When set, new agent registrations go into 'pending' state and must be
# approved via POST /agents/{id}/approve (X-Admin-Key header) or the
# dashboard Approve button. Leave empty for open registration.
# Generate a strong random value: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ──────────────────────────────────────────────────────────────
ADMIN_KEY=

# ──────────────────────────────────────────────────────────────
# Ollama (for summarization and embeddings)
# ──────────────────────────────────────────────────────────────
# This value is for the CONTAINERS. Anything running on the host (the stdio MCP
# server, pytest, ad-hoc scripts) cannot resolve host.docker.internal — put
# OLLAMA_BASE_URL=http://localhost:11434 in .env.local, which pydantic-settings
# loads after this file. Skipping that makes every host-side embedding call fail
# with "[Errno 8] nodename nor servname provided".
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:latest
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=300

# ──────────────────────────────────────────────────────────────
# Code volume mounts
# Absolute paths to your code roots on the HOST machine. Each is
# mounted read-only into the container at the SAME absolute path,
# so project paths stored in the DB resolve during analysis.
# A project whose path is not covered by one of these mounts will
# fail analysis with "No such file or directory".
# Example: PROJECTS_HOST_PATH=/home/yourname/Projects
# ──────────────────────────────────────────────────────────────
PROJECTS_HOST_PATH=~/Projects
SITES_HOST_PATH=~/Sites

# ──────────────────────────────────────────────────────────────
# Service
# ──────────────────────────────────────────────────────────────
APP_PORT=8007
APP_HOST=0.0.0.0
LOG_LEVEL=info
